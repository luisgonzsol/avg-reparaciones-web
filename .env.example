# ============================================================
# Variables de entorno de AVG Reparaciones
# Copia este archivo como `.env.local` y rellena los valores.
# NUNCA subas `.env.local` a git (ya está en .gitignore).
# ============================================================

# URL pública del sitio (sin barra final). En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Fase 3) ---
# Públicas: se pueden ver en el navegador (protegidas por RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SECRETA: solo servidor. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Emails con Resend (Fase 4) ---
# Sin RESEND_API_KEY o EMAIL_FROM, los emails se omiten (la web funciona igual).
# SECRETA: solo servidor.
RESEND_API_KEY=
# Remitente con un dominio verificado en Resend, p. ej.:
# EMAIL_FROM="AVG Reparaciones <avisos@tudominio.com>"
EMAIL_FROM=
# Buzón que recibe los avisos de pedidos, solicitudes y mensajes.
# Si se deja vacío, se usa el email de Panel → Ajustes.
EMAIL_NOTIFY_TO=

# --- Antispam Cloudflare Turnstile (Fase 4, opcional) ---
# Con las dos claves, los formularios públicos y el login piden la verificación.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cadena de conexión (Session pooler) para aplicar migraciones con `npm run db:push`.
# SECRETA: solo en tu equipo, nunca en Vercel ni en git.
SUPABASE_DB_URL=

# Sal para el hash de IPs del rate limiting (opcional; por defecto usa la clave secreta).
RATE_LIMIT_SALT=
